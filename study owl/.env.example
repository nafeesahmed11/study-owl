# ─────────────────────────────────────────────────────────────────────────────
# Google Drive + Classroom integration
#
# PUBLIC OAuth client id only. Vite inlines every VITE_* value into the browser
# bundle, so never put a client secret here — the Google Identity Services token
# model used by src/lib/googleAuth.ts does not use one.
#
# Create it at https://console.cloud.google.com/apis/credentials
#   1. Enable the "Google Drive API" and "Google Classroom API".
#   2. Configure the OAuth consent screen (add yourself under Test users).
#   3. Create an OAuth client ID of type "Web application".
#
# No redirect URI is required by this flow — the consent popup returns the
# token directly to the page.
# ─────────────────────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Auth + Postgres
#
# Get both values from Supabase dashboard → Project Settings → API.
# Vite exposes VITE_* values in the browser bundle, so use only the project's
# public anon/publishable key here. Never use a service_role key.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
